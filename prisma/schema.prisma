// Axiomate TMS — durable model for the Issue Tree & Resolution Schedule.
//
// The concerns the application keeps apart are kept apart here too:
//
//   TENANCY       Tenant           — whose data this is; the isolation boundary
//   HIERARCHY     HierarchyNode.parentId / Issue.parentIssueId — where a record sits
//   RELATIONSHIPS IssueRelationship — business links, no scheduling effect
//   SCHEDULING    IssueDependency  — timing constraints between activities
//   EVIDENCE      Evidence         — what was attached, and what it proves
//   CONFIGURATION OperatingModel   — terminology, roles, responsibilities, agents
//   AUDIT         ScheduleAudit    — every change, including soft deletes
//
// IssueRelationship and IssueDependency are deliberately separate tables. "OAPIL-007 relates
// to OAPIL-008" and "Corrective Action FS→ Verification" are different statements; merging
// them would make it impossible to explain why a date moved.
//
// ---------------------------------------------------------------------------
// Three rules this schema follows, all learned the hard way in this codebase
//
// 1. IDS ARE SUPPLIED BY THE APPLICATION, NOT GENERATED HERE.
//    `client:OAPIL`, `module:OAPIL:Inventory`, `OAPIL-143`, `OAPIL-143#7` are not opaque
//    keys — they are looked up by construction (`moduleNodeId`) and used as configuration
//    scope keys. A database-generated cuid would silently detach every scope override and
//    send chat-created issues to the wrong parent. `@default(cuid())` remains only as a
//    fallback for rows nothing constructs by hand.
//
// 2. THOSE IDS ARE UNIQUE WITHIN A TENANT, NOT GLOBALLY — SO EVERY KEY IS COMPOSITE.
//    This follows from rule 1 rather than being a separate choice. Two firms running
//    Axiomate both have a `company:root`; both mint `rel-1`, `dep-1` and `ev-1` from their
//    own counter; both may serve a client whose code is `OAPIL`. So the primary key of every
//    table is `(tenantId, id)`, every foreign key carries the tenant across with it, and
//    every uniqueness constraint is scoped by it. One rule, applied without exception —
//    a single table where it does not hold is a table two tenants can collide in.
//
//    What this does NOT do is enforce isolation. Nothing here stops a query that forgets its
//    `where`; the compiler does that (see `TenantId` in lib/tenant.ts), and row-level
//    security would do it properly — but RLS needs a database role per request, which needs
//    identity, which this application does not yet have. Stated rather than implied.
//
// 3. DERIVED VALUES ARE NOT STORED AS FACT.
//    `duration`, `scheduleHealth` and `projectedCompletionDate` used to have columns here.
//    Nothing in the reducer produces them — they are recomputed from dates and status on
//    every render — so a stored copy is a stale computation wearing the costume of a
//    recorded one. They are gone. The same rule already governs `% complete`, which is
//    stored only when a user overrides the status-derived figure.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 takes the connection URL from prisma.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

enum NodeKind {
  COMPANY
  CLIENT
  ENGAGEMENT
  PROJECT
  MODULE
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum ScheduleMode {
  MANUAL
  AUTO
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

/// Where an activity's dates and progress came from. `GENERATED` rows were synthesised by the
/// lifecycle builder and were never reported by anyone; they flip to `USER` on first edit.
enum ActivityOrigin {
  GENERATED
  USER
}

enum EvidenceKind {
  SNAPSHOT
  DATA
  DOCUMENT
  LINK
}

/// `IMPORTED` items were reconstructed from the issue log's evidence text and are read-only
/// descriptions of material this system does not hold. `USER` items were attached here.
enum EvidenceOrigin {
  IMPORTED
  USER
}

/// The delivery firm operating a workspace, and the isolation boundary around everything it
/// holds. Not a tier of the tree: `company:root` is how the firm *appears* in its own
/// hierarchy and a user may rename or archive it, while this row is the key every other row
/// hangs from and the application never edits.
///
/// `name` is the provisioning label only. `OperatingModel.organization.name` is the configured
/// one and supersedes it everywhere the application renders a name — the same separation
/// `partyCode` keeps from the firm's display name, so a rename never orphans stored rows.
/// It exists for the case configuration cannot cover: a tenant created before it has any.
///
/// Deleting is restricted rather than cascaded. Everything in this schema is archived and
/// never destroyed; a tenant that owns records is suspended with `deletedAt`, not dropped
/// along with every issue anyone ever filed under it.
model Tenant {
  /// A readable slug — `axiocloud`. Appears in browser storage keys and operational queries.
  id   String @id
  name String

  nodes         HierarchyNode[]
  issues        Issue[]
  activities    IssueActivity[]
  dependencies  IssueDependency[]
  relationships IssueRelationship[]
  evidence      Evidence[]
  notes         IssueNote[]
  engagements   Engagement[]
  operatingModel OperatingModel?
  meta          WorkspaceMeta?
  watch         ScheduleWatch?
  allocations   Allocation[]
  projectMembers ProjectMember[]
  personalEvents PersonalEvent[]
  commitments   Commitment[]
  sows          Sow[]
  notifications Notification[]
  approvals     Approval[]
  timeEntries   TimeEntry[]
  estimates     IssueEstimate[]
  revisions     EstimateRevision[]
  audit         ScheduleAudit[]
  appliedActions AppliedAction[]
  versions      Version[]
  timesheets    Timesheet[]
  rates         PersonRate[]
  changes       ChangeRequest[]
  personSkills  PersonSkill[]
  documents     Document[]
  documentReviews DocumentReview[]
  milestones    Milestone[]
  scopeItems    ScopeItem[]

  /// Suspension. A suspended tenant keeps every record it owns.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Structural tiers above an issue: Company ▸ Client ▸ Engagement ▸ Project ▸ Process Area.
/// Self-referencing so the tree can be any depth the client's delivery shape needs.
model HierarchyNode {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Application-supplied and meaningful — e.g. `client:OAPIL`, `module:OAPIL:Inventory`.
  /// Configuration scope overrides are keyed on this value. Unique within the tenant only.
  id       String   @default(cuid())
  kind     NodeKind
  name     String
  owner    String?

  /// The tenant travels with the parent reference: a node can only be parented within its
  /// own tenant, and the database is what says so rather than the code remembering to.
  parentId String?
  parent   HierarchyNode?  @relation("NodeTree", fields: [tenantId, parentId], references: [tenantId, id])
  children HierarchyNode[] @relation("NodeTree")

  issues Issue[]
  /// Present only on engagement nodes.
  engagement Engagement?

  /// Soft delete. Records are archived, never destroyed, so history stays intact.
  deletedAt DateTime?
  /// The statement of work this project is delivered under. Projects only, and nullable —
  /// a project attached to nothing is exactly the unattributed state the scope screen reports.
  sowId String?
  /// Restrict rather than SetNull: the reducer already refuses to archive a statement of work
  /// with live projects under it, so a delete reaching this constraint means something has
  /// gone round the reducer — which should fail loudly rather than quietly orphan the work.
  sow   Sow?    @relation("SowDelivery", fields: [tenantId, sowId], references: [tenantId, id], onDelete: Restrict)
  /// SOWs filed against this node, when it is an engagement.
  sowsHere Sow[] @relation("SowEngagement")
  allocations Allocation[] @relation("ProjectAllocation")
  projectMembers ProjectMember[] @relation("ProjectMembership")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([tenantId, id])
  @@index([tenantId, parentId])
  @@index([tenantId, deletedAt])
}

model Issue {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The issue key from the log — `OAPIL-010`. Never regenerated. Unique within the tenant.
  id      String
  subject String
  description String @db.Text

  /// Where this issue sits. Either under a hierarchy node, or under another issue
  /// (a sub-issue) — never both.
  nodeId        String?
  node          HierarchyNode? @relation(fields: [tenantId, nodeId], references: [tenantId, id])
  parentIssueId String?
  parentIssue   Issue?         @relation("IssueTree", fields: [tenantId, parentIssueId], references: [tenantId, id])
  subIssues     Issue[]        @relation("IssueTree")

  client String
  module String
  type   String
  /// What the source log called this, when `type` was mapped onto another taxonomy. Empty for
  /// records created here — they were never classified as anything else.
  sourceType String @default("")

  /// Which discipline resolves this — a `Discipline` id from the operating model, or empty.
  ///
  /// A THIRD classification axis, independent of `type` and `module`, and the independence is
  /// the point: a Technical issue can be a Defect or a Change Request, and can sit in any
  /// module. Folding it into `type` would make "the technical defects" unaskable.
  ///
  /// A String rather than an enum, and not a foreign key, for the same reason `type` and
  /// `accountable` are strings: the vocabulary is configurable, and an enum here would reject a
  /// discipline a firm adds until a migration caught up. `disciplineLabel()` resolves an id that
  /// no longer exists to the id itself rather than to blank, so a deleted discipline leaves a
  /// visible trace instead of silently unclassifying a hundred issues.
  ///
  /// **Empty means unclassified, and every imported issue is empty.** Nothing infers this from
  /// the module or the subject — an inference would be right often enough to be trusted and
  /// wrong invisibly, which is the objection.
  discipline String @default("")

  severity    Severity
  /// Free text rather than an enum: the seven statuses come from the source log, and the
  /// transform is the only thing entitled to interpret them.
  status      String
  owner       String
  /// The directory id half of the person reference, resolved at write time. Null when the
  /// name did not uniquely resolve, and on rows written before the identity-id migration.
  ownerId     String?
  /// Whether a client-facing surface may show this record. Default false — marked by a person.
  clientVisible Boolean @default(false)
  /// A risk's judged halves, 1-5; null = not yet judged. Exposure is computed, never stored.
  riskLikelihood Int?
  riskImpact     Int?
  /// A decision's recorded outcome.
  decisionOutcome String? @db.Text
  raisedBy    String
  /// String, not an enum. The accountable-party vocabulary is configurable
  /// (`OperatingModel.parties`), so an enum here would reject any party a user adds.
  accountable String

  // ---- Scheduling ----
  scheduleMode     ScheduleMode @default(AUTO)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  /// Set only when a user overrides the status-derived figure. Null means "derive it".
  percentOverride  Int?

  // ---- Provenance from the source log ----
  raisedDate       DateTime
  lastActivityDate DateTime
  /// Completion date. Derived from the status change that closed the issue, and rewritten
  /// only when the status actually changes.
  actualEndDate    DateTime?
  /// When the current status was entered — anchors the client-waiting pause clock.
  statusSince      DateTime?
  /// Calendar days banked in client-waiting statuses; health shifts the due comparison.
  pausedDays       Int       @default(0)
  /// Days since raised / since last activity, as recorded by the transform.
  age              Int @default(0)
  daysSinceActivity Int @default(0)
  nextAction       String  @db.Text
  /// The evidence *description* carried by the source row. Attached files live in `Evidence`.
  evidence         String  @db.Text
  evidenceDate     DateTime?
  /// How well the source row was corroborated: verified from thread / snippet only / register.
  verification     String
  source           String
  reference        String
  clientImpact     String  @db.Text

  /// Values for configured responsibility types that have no column of their own, keyed by
  /// responsibility type id. The three seeded types keep their own columns above.
  assignments Json @default("{}")

  activities        IssueActivity[]
  relationshipsFrom IssueRelationship[] @relation("RelSource")
  relationshipsTo   IssueRelationship[] @relation("RelTarget")
  evidenceItems     Evidence[]
  estimate          IssueEstimate?
  timeEntries       TimeEntry[]
  approvals         Approval[]
  notifications     Notification[]
  notes             IssueNote[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([tenantId, id])
  @@index([tenantId, nodeId])
  @@index([tenantId, parentIssueId])
  @@index([tenantId, client, module])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
}

/// A scheduled lifecycle activity beneath an issue (Investigation, RCA, ...), or a milestone.
/// The source log has no activity breakdown, so every row here originates in this app.
model IssueActivity {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Application-supplied — `OAPIL-010#7`.
  id      String @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [tenantId, issueId], references: [tenantId, id], onDelete: Cascade)

  /// The phase name, or the milestone's name. Free text: the five standard phases are a
  /// convention of the lifecycle builder, not a constraint on what a user may add.
  phase String
  order Int

  scheduleMode     ScheduleMode @default(MANUAL)
  plannedStartDate DateTime
  plannedEndDate   DateTime
  percentComplete  Int          @default(0)

  isMilestone Boolean        @default(false)
  origin      ActivityOrigin @default(USER)
  owner       String

  predecessors IssueDependency[] @relation("DepSuccessor")
  successors   IssueDependency[] @relation("DepPredecessor")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([tenantId, id])
  @@index([tenantId, issueId, order])
  @@index([tenantId, deletedAt])
}

/// A SCHEDULING constraint between two activities. Drives the Critical Resolution Path.
/// Not to be confused with IssueRelationship.
model IssueDependency {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `dep-9`, minted from the workspace counter — unique within the tenant, not globally.
  id String @default(cuid())

  predecessorId String
  predecessor   IssueActivity @relation("DepPredecessor", fields: [tenantId, predecessorId], references: [tenantId, id], onDelete: Cascade)
  successorId   String
  successor     IssueActivity @relation("DepSuccessor", fields: [tenantId, successorId], references: [tenantId, id], onDelete: Cascade)

  dependencyType DependencyType @default(FS)
  lagDays        Int            @default(0)

  createdAt DateTime @default(now())
  createdBy String

  @@id([tenantId, id])
  @@unique([tenantId, predecessorId, successorId])
  @@index([tenantId, successorId])
}

/// A BUSINESS link between two issues. Carries no scheduling meaning and never moves a date.
model IssueRelationship {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `rel-4`, minted from the workspace counter — unique within the tenant, not globally.
  id String @default(cuid())

  sourceIssueId String
  sourceIssue   Issue  @relation("RelSource", fields: [tenantId, sourceIssueId], references: [tenantId, id], onDelete: Cascade)
  targetIssueId String
  targetIssue   Issue  @relation("RelTarget", fields: [tenantId, targetIssueId], references: [tenantId, id], onDelete: Cascade)

  /// RELATED_TO | DUPLICATE_OF | CAUSED_BY | BLOCKS
  relationshipType String
  note             String @db.Text

  createdAt DateTime @default(now())
  createdBy String   @default("system")

  @@id([tenantId, id])
  @@unique([tenantId, sourceIssueId, targetIssueId, relationshipType])
  @@index([tenantId, targetIssueId])
}

/// Something attached to an issue that supports a claim about it.
///
/// A snapshot is not a document: a snapshot is a moment captured to prove a state, and it
/// carries the purpose it was captured for.
///
/// The source document a piece of evidence traces back to is deliberately NOT a column.
/// `detectSourceDocument()` derives it from the issue's subject and reference at render time,
/// and storing a copy would freeze a derivation that its inputs can outgrow — the same rule
/// that keeps `duration` and `scheduleHealth` out of this schema.
model Evidence {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `ev-12`, minted from the workspace counter — unique within the tenant, not globally.
  id      String @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [tenantId, issueId], references: [tenantId, id], onDelete: Cascade)

  kind EvidenceKind
  /// File name, or link title.
  name String
  /// Only meaningful for snapshots — what the capture was taken to demonstrate.
  purpose   String?
  /// External URL for links. Object URLs for files held in one browser session are not
  /// durable and are not written here.
  url       String?
  mimeType  String?
  sizeBytes Int?
  note      String  @db.Text

  /// The stored file this row describes, when the app holds one. Null for an imported row (which
  /// describes material nobody kept) and for a link (which points elsewhere).
  ///
  /// No foreign key, deliberately: `Document` hangs off four different kinds of subject and is
  /// withdrawn softly, so a constraint here would either block a withdrawal or cascade one
  /// record's deletion into another's. The reducer clears this field when a document is
  /// withdrawn, which is the same job done where the rule is readable.
  documentId String?

  origin  EvidenceOrigin @default(USER)
  addedAt DateTime
  addedBy String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([tenantId, id])
  @@index([tenantId, issueId, kind])
  @@index([tenantId, deletedAt])
}

/// What a person wrote down about how an issue actually progressed.
///
/// Not the audit trail, and deliberately a separate table. An audit row is produced *by* a
/// change and nobody writes it; a note is written on purpose and describes something the system
/// cannot observe — what was tried, what the client said, why an approach was abandoned.
/// Merging them would mean either a trail full of prose that no longer proves what changed, or
/// notes that vanish when the audit cap trims the oldest rows.
///
/// `createdAt`/`updatedAt` here are APPLICATION-SUPPLIED DOMAIN FACTS, which is why this is the
/// one model in the file without `@default(now())` and `@updatedAt`. A note records when a
/// person wrote it, not when a row was inserted, and the two are only the same until an import
/// or a queued write is replayed. The tradeoff is real and worth stating: those names can carry
/// one meaning each, so buying the domain fact costs the row metadata — this table records
/// nothing at all about when its rows reached the database.
model IssueNote {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `note-12`, minted from the workspace counter — unique within the tenant, not globally.
  id      String @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [tenantId, issueId], references: [tenantId, id], onDelete: Cascade)

  body String @db.Text
  /// String, not an enum. The vocabulary is owned by the app (`NOTE_TYPES`), and an enum here
  /// would reject a type added in a later build until a migration caught up with it.
  noteType String
  /// Pinned notes sort above the rest, whatever their age.
  pinned   Boolean @default(false)
  /// Whether a client-facing surface may show this note. The sent client reply is born true.
  clientVisible Boolean @default(false)

  /// Authorship of the original observation. Never rewritten by an edit — a correction three
  /// weeks later must not reassign who first made the remark, or when.
  createdBy String
  createdAt DateTime
  updatedBy String?
  updatedAt DateTime?

  /// Soft delete, like every other record here: a working record that can be silently removed
  /// is not a record of anything.
  deletedAt DateTime?

  @@id([tenantId, id])
  @@index([tenantId, issueId])
  @@index([tenantId, deletedAt])
}

/// The commercial and delivery envelope around a body of work for one client.
///
/// Only recorded facts live here. Issue counts, date spans, process areas in scope, owners and
/// status spread are all computed from the issues on every render — storing them would be the
/// same mistake as storing `duration`, and would go stale the first time anyone filed an issue.
///
/// Every field starts empty. The issue log records issues, not contracts, so there is nothing
/// to import: a blank engagement with a truthful derived summary beats a plausible invented one.
model Engagement {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The hierarchy node this describes — `engagement:OAPIL`. One row per engagement node.
  nodeId String
  node   HierarchyNode @relation(fields: [tenantId, nodeId], references: [tenantId, id], onDelete: Cascade)

  client String
  code   String @default("")
  /// Implementation | Rollout | Support | Hypercare | Advisory | Managed Service. Free text
  /// rather than an enum: engagement shapes are a commercial vocabulary, and a firm that runs
  /// a kind this list does not name should not be blocked from recording it.
  type   String @default("")
  status String @default("")

  startDate DateTime?
  endDate   DateTime?

  /// Delivery side.
  engagementLeader String @default("")
  projectManager   String @default("")
  /// Client side.
  clientSponsor    String @default("")

  sowReference String @default("")
  notes        String @default("") @db.Text

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([tenantId, nodeId])
  @@index([tenantId, client])
}

/// The operating model — terminology, roles, the person directory, responsibility types,
/// the agent registry, workflows, templates, routing rules, mail intake and scope overrides.
///
/// One row per tenant, one JSON document, deliberately. It is small, it is edited as a whole,
/// and the application already serialises exactly this shape to local storage. The tradeoff is
/// real and worth stating: there is no referential integrity between the `overrides` keys and
/// `HierarchyNode.id`, so a deleted node leaves an orphaned override behind. Resolution
/// ignores overrides for scopes that no longer resolve, so the effect is dead weight rather
/// than incorrect behaviour.
///
/// The primary key *is* the tenant. It was `id @default("singleton")` — a hardcoded assertion
/// that one installation serves one firm, which is exactly the assumption tenancy removes.
model OperatingModel {
  tenantId  String @id
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  model     Json
  updatedAt DateTime @updatedAt
}

/// Counters that must not restart when the process does.
///
/// `seq` mints `engagement:5`, `OAPIL-143#7`, `ev-12`, `dep-9`. It lives in memory during a
/// session and would reset to 1 on every boot — handing out ids that collide with records
/// already stored. Persisting it is what makes application-supplied ids safe across restarts.
///
/// Per tenant, like the operating model, and for a second reason beyond isolation: the counter
/// is what makes those ids unique, and two tenants sharing one would make every id in the
/// system depend on how busy the other firm had been.
model WorkspaceMeta {
  tenantId     String @id
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  seq          Int      @default(1)
  /// Set once, when the seed log is imported, so import can never run twice *for this tenant*.
  /// A global guard would refuse to seed the second firm because the first had been seeded,
  /// and would do it silently.
  seededAt     DateTime?
  updatedAt    DateTime @updatedAt
}

/// The scheduled pass's memory: one row per tenant.
///
/// `observation` is the set of temporal conditions that were true at the last run, keyed by the
/// record they were true of. It exists so the pass can raise a condition once rather than every
/// morning — the difference between an alert somebody reads and one they filter.
///
/// Small on purpose. It holds condition keys and nothing else, because everything else it could
/// hold has a home already and would be a second copy free to disagree.
model ScheduleWatch {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lastRunAt   DateTime?
  /// `Record<subjectId, conditionKey[]>`
  observation Json      @default("{}")
  /// What the last run did, for the screen that reports it.
  lastSummary String    @db.Text @default("")
}

/// Somebody committed to a project, for a period, at a share of their time.
///
/// The share is a percentage of *that person's* available time rather than of a standard week,
/// so part-time is expressed once — on their resource profile — instead of being re-derived
/// wherever an allocation is read.
model Allocation {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id        String        @default(cuid())
  person    String
  personId  String?
  projectId String
  project   HierarchyNode @relation("ProjectAllocation", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  startDate  DateTime
  endDate    DateTime
  percentage Int
  note       String @db.Text

  createdBy String
  createdAt DateTime
  deletedAt DateTime?

  @@id([tenantId, id])
  @@index([tenantId, person, startDate])
  @@index([tenantId, projectId])
}

/// Who may see and act on a project — an access fact, not a capacity one. See Allocation above
/// for the sibling question this answers about the same node.
///
/// personId is required, unlike Allocation.personId — a row that cannot resolve to a directory
/// id is an access-control fact nothing will ever match against a signed-in session, so the
/// reducer refuses to create one rather than storing it silently useless.
model ProjectMember {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id        String        @default(cuid())
  person    String
  personId  String
  projectId String
  project   HierarchyNode @relation("ProjectMembership", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  projectRoleId String

  addedBy   String
  addedAt   DateTime
  removedAt DateTime?

  @@id([tenantId, id])
  @@index([tenantId, projectId, personId])
  @@index([tenantId, personId])
}

/// A person's own calendar entry — typed in, not synced from anywhere. Private to its owner
/// unconditionally; see redactForReader in lib/db/boot.ts, which filters this table with no
/// exemption for any role, including ADMIN.
model PersonalEvent {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id       String @default(cuid())
  personId String

  title     String
  startAt   DateTime
  endAt     DateTime
  allDay    Boolean @default(false)
  note      String  @db.Text
  attendees String  @db.Text

  createdAt DateTime
  deletedAt DateTime?

  @@id([tenantId, id])
  @@index([tenantId, personId])
}

/// Leave, a public holiday, or internal work — what comes off capacity before anything is sold.
///
/// Not attached to a project, deliberately: this is the time that exists outside delivery, and
/// filing it under a project would make it disappear the day that project closes.
model Commitment {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id     String @default(cuid())
  person String
  personId String?
  kind   String

  startDate   DateTime
  endDate     DateTime
  /// Hours a day this takes, so a period can be extended without recomputing a total.
  hoursPerDay Decimal @db.Decimal(4, 2)
  note        String  @db.Text

  createdBy String
  createdAt DateTime
  deletedAt DateTime?

  @@id([tenantId, id])
  @@index([tenantId, person, startDate])
}

/// What has been contracted, under one engagement.
///
/// `effortHours` and `value` are the baseline, and both are kept because they answer different
/// questions and move independently: a fixed-price SOW can be on budget and badly over on
/// effort, which is the case a firm needs to see before pricing the next one the same way.
///
/// `value` is Decimal for the same reason time is: it is money, and it will be summed.
model Sow {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id           String         @default(cuid())
  engagementId String
  engagement   HierarchyNode  @relation("SowEngagement", fields: [tenantId, engagementId], references: [tenantId, id], onDelete: Cascade)

  reference String
  title     String
  status    String
  signedOn  DateTime?
  startDate DateTime?
  endDate   DateTime?

  effortHours Int     @default(0)
  value       Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("GBP")

  scope              String @db.Text
  exclusions         String @db.Text
  acceptanceCriteria String @db.Text

  createdBy String
  createdAt DateTime
  updatedBy String?
  updatedAt DateTime?
  deletedAt DateTime?

  /// Projects delivered under it.
  projects HierarchyNode[] @relation("SowDelivery")
  /// Variations to this contract. Deltas — see `ChangeRequest`.
  changes    ChangeRequest[]
  milestones Milestone[]
  scopeItems ScopeItem[]

  @@id([tenantId, id])
  @@index([tenantId, engagementId])
  @@unique([tenantId, engagementId, reference])
}

/// A message raised for somebody, and whether it got anywhere.
///
/// `delivery` is the point of the table. A `sendMail` call with a try/catch answers neither
/// "did it arrive" nor "does anybody know it did not"; a record with an outcome answers both.
/// In-app is delivered the moment it is written, because the inbox is the delivery. Every other
/// channel stays `pending`, because no transport is configured — and a pending count in the
/// interface is a true statement about this deployment.
model Notification {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id      String @default(cuid())
  /// Who it is for, by name — the same join used everywhere until people have keys.
  to      String
  toId    String?
  channel String

  subject String @db.Text
  body    String @db.Text

  /// The record it is about.
  aboutId String
  issue   Issue  @relation(fields: [tenantId, aboutId], references: [tenantId, id], onDelete: Cascade)
  /// Which rule raised it, so a noisy rule can be found and switched off.
  ruleId  String

  createdAt    DateTime
  delivery     String
  deliveryNote String   @db.Text
  readAt       DateTime?

  @@id([tenantId, id])
  /// "What is waiting for me" and "what never left the building" are the two queries.
  @@index([tenantId, to, readAt])
  @@index([tenantId, delivery])
}

/// A decision somebody with authority was asked for, and gave or refused.
///
/// `question` is copied from the rule rather than referenced, so editing a rule later cannot
/// rewrite what a person was actually asked — the same reason an estimate revision keeps its
/// own before-and-after instead of pointing at a calibration that moves.
///
/// A rejected decision is kept, not cleared. The refusal is the record that a change was
/// declined rather than never considered.
model Approval {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id        String @default(cuid())
  /// The record it is about. Issues today; nothing here assumes that stays true.
  subjectId String
  issue     Issue  @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Cascade)

  /// The rule as it stood when this was asked. Rules live in the operating model, not here.
  ruleId   String
  question String @db.Text
  note     String @db.Text

  requestedBy String
  requestedAt DateTime

  decision     String?
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String    @db.Text

  deletedAt DateTime?

  @@id([tenantId, id])
  /// "What is waiting on me" and "what has this record been through" are the two questions.
  @@index([tenantId, subjectId])
  @@index([tenantId, decision, requestedAt])
}

/// Hours spent, against the work they were spent on.
///
/// The entry is the record, not the timesheet. A timesheet is a week of these presented for
/// approval, and treating *it* as the record is how an entry edited after approval silently
/// changes an approved total. When approval arrives it will name the entries it covered.
///
/// `hours` is a Decimal rather than a Float. Quarter hours summed across a month feed an
/// invoice, and binary floating point cannot hold 0.25 + 0.25 + 0.25 exactly enough to be
/// argued about with a client.
model TimeEntry {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id      String @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [tenantId, issueId], references: [tenantId, id], onDelete: Cascade)

  /// Who did the work, by name — the same join the rest of the model uses until people have keys.
  person String
  personId String?
  /// The day the work happened, not the day it was typed in.
  date   DateTime
  hours  Decimal @db.Decimal(5, 2)

  activity String
  billable Boolean @default(true)
  note     String  @db.Text
  /// Why the entry lagged the work past the workspace's allowance. Null when recorded in time.
  justification String? @db.Text

  createdBy String
  createdAt DateTime
  updatedBy String?
  updatedAt DateTime?
  /// Soft, and more pointedly than elsewhere: hours drive money, and an entry that can vanish
  /// is an entry nobody can reconcile against an invoice.
  deletedAt DateTime?

  @@id([tenantId, id])
  /// The three questions asked of this table: what did this issue cost, what did this person
  /// do, and what happened in this period.
  @@index([tenantId, issueId])
  @@index([tenantId, person, date])
  @@index([tenantId, date])
}

/// An issue's estimate — one per issue, which is why the issue id *is* the key.
///
/// Effort and timeline are stored as their inputs rather than their results: scores, capacity,
/// steps. Every figure the screen shows — total complexity, size, hours, duration, completion
/// date — is recomputed from these on read, because each is a function of the others and of
/// the T-shirt calibration, which is configuration and can change. Storing the derived numbers
/// would freeze an estimate against a calibration nobody uses any more, which is the same rule
/// that keeps `duration` and `scheduleHealth` out of this schema.
model IssueEstimate {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  issueId String
  issue   Issue  @relation(fields: [tenantId, issueId], references: [tenantId, id], onDelete: Cascade)

  /// The five complexity parameters, 1–5 each. 0 means "not scored yet".
  business    Int @default(0)
  technical   Int @default(0)
  integration Int @default(0)
  testing     Int @default(0)
  data        Int @default(0)

  /// Null means "use the size the score implies" / "use the hours the size implies". A null
  /// here is a real state, not a missing value: it says nobody has overridden the derivation.
  sizeOverride        String?
  approvedEffortHours Int?

  /// Capacity as three columns rather than JSON. They are numbers a report will want to group
  /// and average across issues, and JSON would put that behind a parse.
  hoursPerDay   Int @default(8)
  resources     Int @default(1)
  allocationPct Int @default(100)

  plannedStart DateTime
  /// Waiting on a client, an environment, an approval. Entered — there is no dependency
  /// engine to infer it from.
  waitDays     Int @default(0)

  /// The breakdown: `{ id, activity, effortHours, dependsOn[] }`. JSON because the steps have
  /// no identity outside this estimate and are always read and written as one list — the same
  /// judgement as `Issue.assignments`.
  steps Json @default("[]")

  confidence  String  @default("Medium")
  assumptions String  @db.Text
  notes       String  @db.Text

  /// Set when the estimate is agreed. Its presence is what turns a later edit into a revision.
  baselinedAt DateTime?
  baselinedBy String?

  updatedAt DateTime
  updatedBy String

  revisions EstimateRevision[]

  @@id([tenantId, issueId])
  @@index([tenantId, baselinedAt])
}

/// What changed to an agreed estimate, and why.
///
/// `from` and `to` are snapshots of both halves — effort *and* duration — because they move
/// independently: scope can grow without the date slipping if people are added, and the date
/// can slip with no change in effort at all when a client goes quiet. A log that captured only
/// hours would make the second case look like nothing had happened.
model EstimateRevision {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `rev-12`, minted from the workspace counter.
  id      String @default(cuid())
  issueId String
  estimate IssueEstimate @relation(fields: [tenantId, issueId], references: [tenantId, issueId], onDelete: Cascade)

  reason String @db.Text
  by     String
  at     DateTime

  /// `EstimateSummary` either side. JSON because it is a snapshot read as a whole and never
  /// queried field by field.
  from Json
  to   Json

  @@id([tenantId, id])
  @@index([tenantId, issueId, at])
}

/// Every change to a record, including archives, restores and configuration edits.
model ScheduleAudit {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Generated here. The application's in-memory counter (`aud-3-OAPIL-010`) restarts every
  /// session and would collide on this primary key across restarts.
  id     String @default(cuid())
  rowId  String
  field  String
  from   String? @db.Text
  to     String? @db.Text
  reason String? @db.Text
  at     DateTime @default(now())
  /// The display name, which is what History shows.
  by     String
  /// The identity behind that name: the provider's stable object id, and the address it
  /// supplied. Nullable because every row written before this existed has neither, and
  /// because a machine actor has an id and no mailbox. A trail keyed on a display name alone
  /// cannot answer 'everything this account did' — only 'everything anyone called this did'.
  byId    String?
  byEmail String?

  @@id([tenantId, id])
  @@index([tenantId, rowId, at])
  @@index([tenantId, at])
}

/// Keys of actions already applied, so a re-delivered batch does not write itself twice.
///
/// The row is the whole record: its existence is the fact. Nothing reads a column here except
/// the pruner, which needs `at` to know what has aged out — see `KEY_RETENTION_DAYS` in
/// `lib/idempotency.ts` for why thirty days, and why the daily pass prunes rather than the
/// write path.
///
/// The composite primary key is what actually enforces this. The write path checks the set
/// first, but two concurrent batches carrying the same key can both find nothing and both
/// insert; the constraint is what turns that race into an error the transaction retries into
/// the correct answer, rather than a duplicate nobody notices.
model AppliedAction {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Minted by the client when the action entered its queue — never by the server, which
  /// cannot tell a redelivery from a new intent. Shape-checked at the route boundary.
  key String

  at DateTime @default(now())

  @@id([tenantId, key])
  @@index([tenantId, at])
}

/// A week somebody has attested to, and what an approver decided about it.
///
/// It carries NO hours. The entries stay in `TimeEntry`, and the total is derived from them on
/// read — the freeze in the reducer is what stops them moving underneath a submitted week. The
/// alternative, copying the lines onto the sheet at submission, keeps a second copy of every
/// hour that is then free to disagree with the first.
///
/// `@@unique([tenantId, person, weekStarting])` is the rule, not an optimisation: a person has
/// one timesheet per week. A resubmission after a return reuses the row rather than minting a
/// second, and what happened to it is the audit trail.
///
/// `person` is a name, like `TimeEntry.person` and for the same reason — the same join the rest
/// of the model uses until people have keys.
model Timesheet {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `ts-12`, minted from the durable workspace counter.
  id     String
  person String
  personId String?
  /// ISO date, always a Monday. Not a week number: ISO and US numbering disagree about which
  /// week is which, and neither is readable in a database row.
  weekStarting String

  /// Submitted | Approved | Rejected. A String rather than an enum, as `status` is on Issue —
  /// the vocabulary is the product's and an enum here would need a migration to extend.
  status String

  submittedAt DateTime
  submittedBy String
  decidedAt   DateTime?
  decidedBy   String?
  /// Why it was returned. Required on a rejection and null on an approval: "yes" is complete on
  /// its own, "no" is not.
  reason String? @db.Text

  @@id([tenantId, id])
  @@unique([tenantId, person, weekStarting])
  @@index([tenantId, status])
}

/// A change to what was contracted \u2014 a record, not a status.
///
/// The figures here are DELTAS, signed, and `Sow.effortHours` / `Sow.value` are never touched by
/// one. That is the whole design: adding the movement to the SOW gives the same current total in
/// one field instead of two and permanently destroys the answer to what a delivery review
/// actually asks \u2014 what did we agree, what has been added since, and who approved each piece.
/// A baseline that moves is not a baseline. The contracted position is computed on read, the same
/// rule that keeps `duration` and `scheduleHealth` out of this schema.
///
/// Only an `Approved` row counts toward any total. A request that has been asked for is not a
/// change to the contract, and showing a proposed value inside the agreed one is how a firm
/// reports revenue it has not won.
///
/// `issueId` is nullable and loose on purpose: a change is often raised in the register long
/// before anybody prices it, and requiring the link would mean inventing an issue or refusing to
/// record a change that arrived by email.
model ChangeRequest {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `cr-12`, minted from the durable workspace counter.
  id    String
  sowId String
  /// Cascade: a change request without its statement of work is not a record of anything. The
  /// SOW itself is soft-deleted, so this only fires if a SOW is ever truly removed.
  sow   Sow    @relation(fields: [tenantId, sowId], references: [tenantId, id], onDelete: Cascade)

  /// The issue it came from, when it came from one. No FK \u2014 see the model comment.
  issueId String?

  reference String @default("")
  title     String
  /// Draft | Submitted | Approved | Rejected | Withdrawn.
  status    String

  /// Signed movements. Negative is a descoping, which happens and which an unsigned column
  /// would force somebody to record as a note.
  effortHours Int     @default(0)
  value       Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("GBP")

  scope  String @db.Text
  reason String @db.Text

  /// When the change takes effect, which is not when it was approved. A change agreed in August
  /// that applies from July is ordinary, and a position computed as at a date needs to know.
  effectiveFrom String?

  requestedBy String
  requestedAt DateTime
  decidedBy   String?
  decidedAt   DateTime?
  /// Why it was refused. Required on a rejection.
  decisionNote String? @db.Text

  deletedAt DateTime?

  @@id([tenantId, id])
  @@index([tenantId, sowId, status])
}

/// What a person costs, and what they are charged out at, over a period.
///
/// Deliberately NOT a `Version`, although the mechanism is identical and `lib/versioning.ts`
/// predicts this exact use. `WorkspaceState.versions` is serialised into the page payload and
/// reaches the browser; putting a cost rate in the same collection as a working pattern would
/// make every reader of any dated fact a reader of everybody's pay. Rates are a separate
/// collection with a separate permission, redacted in `boot()` for anyone without `rate.view`.
///
/// The arithmetic is still shared — `lib/rates.ts` delegates every period question to
/// `lib/versioning.ts`, so the exclusive `validTo` and the overlap refusal are the proven ones
/// rather than a second implementation.
///
/// `cost` and `bill` are rows, not columns, because they move independently: a pay rise does not
/// change a signed rate card, and a renegotiated rate card does not change anybody's salary. A
/// row per rate per period is the only shape that can say the bill rate changed in April and the
/// cost rate did not.
///
/// `personId` is the DIRECTORY id, not a name. Everything else in this schema still joins people
/// by name; a rate is the one record where surviving a rename is not optional.
model PersonRate {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `rate-12`, minted from the durable workspace counter.
  id       String
  personId String
  /// cost | bill.
  kind     String

  /// Inclusive. String for the same reason `Version.validFrom` is — the comparison is a string
  /// comparison and a DateTime round trip has no honest conversion into a non-null field.
  validFrom String
  /// EXCLUSIVE. Null means still true.
  validTo   String?

  /// Per hour. Decimal because it is money and it will be summed.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("GBP")

  recordedAt DateTime
  by         String
  byId       String?
  byEmail    String?
  reason     String  @db.Text

  @@id([tenantId, id])
  @@index([tenantId, personId, kind, validFrom])
}

/// What a person can do, at what level, and who says so.
///
/// A table rather than a key in the OperatingModel document, unlike the skill CATALOGUE which is
/// a firm vocabulary and lives there. This is a per-person record: attributed, dated, corrected,
/// withdrawn, and it grows with the directory rather than with the firm's taxonomy.
///
/// `level` and `source` are stored non-null and always populated. The nullable version of those
/// fields exists only on the copy that crosses the boundary, where `lib/skills.ts` strips them
/// for a reader without `skill.view` — see the note there. Nothing in this table is ever
/// withheld from the reducer, which needs every row to refuse a duplicate.
///
/// `personId` is the DIRECTORY id, like `PersonRate.personId`. A skill survives a rename.
model PersonSkill {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `pskill-12`, minted from the durable workspace counter.
  id       String
  personId String
  /// References `OperatingModel.skills` — a JSON document, so no foreign key can enforce it.
  /// The reducer refuses a record against an unknown or retired skill instead.
  skillId  String

  /// aware | working | practitioner | expert.
  level  String
  /// self | assessed | certified.
  source String
  /// Who assessed it. Required by the reducer when `source` is `assessed`, null otherwise.
  assessedBy String?

  /// When it was last used on real work. Null means nobody has said, which is not the same as
  /// never — and the product reports it as stale rather than as absent.
  lastUsedOn String?
  note       String  @db.Text

  recordedBy String
  recordedAt DateTime
  deletedAt  DateTime?

  @@id([tenantId, id])
  /// The two reads: everybody's level in one skill, and one person's whole profile.
  @@index([tenantId, skillId, level])
  @@index([tenantId, personId])
}

/// A file this application actually holds.
///
/// A row exists ONLY when the bytes exist. There is no "we do not hold this" state, because that
/// is the fault the entity was built to fix — see the note in `lib/documents.ts`. Material the
/// firm does not hold is an `Evidence` row with `origin = 'imported'`, which says so.
///
/// The bytes are not here. They live in the firm's SharePoint document library, reached through
/// Microsoft Graph, and `locator` is the id that finds them again. `store` records WHICH backend,
/// per row rather than from configuration, so a half-finished migration between stores stays
/// legible instead of leaving rows nobody can fetch.
///
/// `subjectKind` + `subjectId` follow `Version`'s polymorphic shape. No foreign key is possible:
/// a document can hang off an issue, a SOW, a hierarchy node or a change request, and two of
/// those are rows while the others are reachable only through this tenant's own tables. The
/// reducer checks the subject exists instead, which is also where an orphan would otherwise be
/// created holding real bytes that nothing lists.
model Document {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `doc-12`, minted from the durable workspace counter.
  id          String
  /// issue | sow | node | change.
  subjectKind String
  subjectId   String

  /// The name as uploaded. Display and download only — never used to build a storage path.
  name      String
  mimeType  String
  sizeBytes Int
  /// SHA-256 of the bytes actually written, hex. Matched WITHIN a tenant only: a cross-tenant
  /// checksum match would answer "does that other firm hold this exact file".
  checksum  String
  /// How the store finds the bytes. Never leaves the server — see `DocumentRecord.locator`.
  locator   String
  /// graph.
  store     String

  /// The document this one replaces — the version chain, linear by the reducer's refusal
  /// of a second successor. Null on originals and on rows stored before phase 6.
  supersedesId String?

  /// Whether a client-facing surface may offer this file. Default false.
  clientVisible Boolean @default(false)

  note         String   @db.Text
  uploadedBy   String
  uploadedById String?
  uploadedAt   DateTime
  deletedAt    DateTime?

  @@id([tenantId, id])
  /// The read that matters: everything attached to one record.
  @@index([tenantId, subjectKind, subjectId])
  /// And the duplicate check, which is per subject and never across the tenant.
  @@index([tenantId, checksum])
}

/// A deliverable review — proofing. See `lib/proofing.ts`.
///
/// `reviewers` and `verdicts` are JSON, read whole and written whole: the screens always
/// arrive holding the review, and no query needs to reach inside a verdict — the design
/// says so, and the send-back list names the day that stops being true.
model DocumentReview {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `rev-12`, minted from the workspace counter.
  id         String
  documentId String
  /// The bytes under review — the stored document's checksum at the moment of asking.
  checksum   String
  /// Where the review surfaces and is audited.
  issueId    String
  question   String   @db.Text
  askedBy    String
  askedAt    DateTime
  /// string[] — directory names. The asker may not appear; the reducer refuses the ask.
  reviewers  Json
  /// { by, verdict, note, at }[] — one per reviewer; a re-answer replaces.
  verdicts   Json
  withdrawnAt DateTime?
  deletedAt   DateTime?

  @@id([tenantId, id])
  @@index([tenantId, documentId])
  @@index([tenantId, issueId])
}

/// A line of what a statement of work says it will deliver.
///
/// **Scope items, not tree tiers.** The revised operating model puts Process, Scenario and
/// Configuration Deliverable in a work hierarchy beneath Process Area; they are recorded here
/// instead, which leaves `NODE_KINDS`, `ALLOWED_PARENTS`, the tree builder and the intake parent
/// check untouched. See `lib/scope.ts`.
///
/// `Sow.scope` keeps the agreement in the document's own words. This is the structured version,
/// and the two are deliberately not required to agree — a paragraph and a list of line items are
/// different renderings of one negotiation.
///
/// There is no `milestone` kind. `Milestone` is a record in its own right, with a payment
/// schedule and its own delivery and acceptance axes; a scope item of that kind would be a second
/// home for one concept.
model ScopeItem {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `scope-12`, minted from the durable workspace counter.
  id    String
  sowId String
  sow   Sow    @relation(fields: [tenantId, sowId], references: [tenantId, id], onDelete: Restrict)

  /// deliverable | acceptance | assumption | exclusion | process | scenario | configuration.
  kind String
  text String @db.Text

  /// One level only, enforced in the reducer: a parent must itself have no parent. Scope lists
  /// what was agreed; a work breakdown is a different thing, and unbounded depth would turn one
  /// into the other by accident. Self-referential, so no foreign key to a separate table.
  parentId String?

  /// Null on kinds that are statements rather than work — an assumption is not built by anybody.
  /// Decimal because a half-day estimate is ordinary and rounding it moves a total.
  effortHours Decimal? @db.Decimal(10, 2)

  /// stated | extracted. `extracted` has no producer yet: SOW intelligence needs a document
  /// library that is one administrator consent short. The value exists now because retrofitting
  /// provenance onto rows already recorded means guessing at it.
  source String

  /// Presentation order, and the order the scope reads in. Not a dependency.
  sequence Int

  /// When this line became part of the AGREED scope, and who said so. Null means recorded but
  /// not agreed — the normal state of anything proposed, and a normal state for a draft.
  approvedBy String?
  approvedAt DateTime?

  recordedBy String
  recordedAt DateTime
  deletedAt  DateTime?

  @@id([tenantId, id])
  @@index([tenantId, sowId, sequence])
  @@index([tenantId, parentId])
}

/// What was promised against a statement of work, when it lands, and what it is worth.
///
/// **Delivery and acceptance are two columns, not one status.** The firm sells "fixed fee — 50%
/// upfront, 50% credited vs implementation" alongside "fixed fee — 4 milestones (25/35/25/15)",
/// and the first bills before anything is delivered. One lane cannot hold that, and collapsing
/// the two also destroys the question the product was built to answer: delivered but not
/// accepted. See `lib/milestone.ts`.
///
/// A statement of work legitimately has NO milestones — six of this firm's services are monthly
/// retainers — so the absence of rows here is a fact about the contract, not a gap in the data.
model Milestone {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `ms-12`, minted from the durable workspace counter.
  id    String
  sowId String
  sow   Sow    @relation(fields: [tenantId, sowId], references: [tenantId, id], onDelete: Restrict)

  name        String
  description String @db.Text
  /// Presentation order and the order a payment schedule reads in. Not a dependency.
  sequence    Int

  /// percentage | amount.
  basis      String
  /// Of the CONTRACTED value — baseline plus approved changes — not of the baseline.
  /// Decimal, because a 33.33% milestone is a real term and rounding it moves money.
  percentage Decimal? @db.Decimal(6, 3)
  amount     Decimal? @db.Decimal(14, 2)
  currency   String   @default("GBP")
  /// acceptance | signature | delivery. A negotiated commercial term, never inferred from state.
  billOn     String

  /// A String date, like every other effective date here — see `Version.validFrom`.
  plannedDate String?

  /// Planned | InProgress | Delivered.
  delivery    String
  deliveredAt DateTime?
  deliveredBy String?

  /// Pending | Accepted | Rejected.
  acceptance    String
  acceptedAt    DateTime?
  acceptedBy    String?
  /// Required by the reducer on a rejection: what has to change before it is presented again.
  rejectionNote String?   @db.Text

  /// What it was worth when it was accepted.
  ///
  /// A derived value deliberately stored, and the exception is argued in `lib/milestone.ts`:
  /// a later approved change request must not retroactively move what a client already signed
  /// off. Null until accepted, and null forever on one that never is.
  acceptedValue Decimal? @db.Decimal(14, 2)

  /// The signed acceptance certificate, when one is held. No foreign key, like
  /// `Evidence.documentId` and for the same reasons.
  evidenceDocumentId String?

  recordedBy String
  recordedAt DateTime
  deletedAt  DateTime?

  @@id([tenantId, id])
  @@index([tenantId, sowId, sequence])
}

/// What was true about something, from when, and why it changed.
///
/// One row is one period. `validFrom` is inclusive and `validTo` is **exclusive**, which is what
/// lets two periods abut without overlapping: a pattern ending `2026-07-01` does not cover 1 July,
/// and the one starting that day does. `validTo` null means "still true". Overlaps are refused by
/// the reducer before a row is ever built — see `overlapProblem` in `lib/versioning.ts`.
///
/// **The dates are `String`, against this schema's own convention, deliberately.** Everywhere else
/// the app holds `YYYY-MM-DD` and the column is a `DateTime` pinned to midnight UTC. Here the
/// comparison itself is a string comparison — `validFrom <= on` — so a `DateTime` column would
/// have to round-trip through `fromDate`, which returns `string | null`, into a non-null field.
/// The only conversion that typechecks is `fromDateOrEmpty`, and `'' <= on` is true for every
/// date, which would make every version cover all of time. A `String` column makes the round trip
/// the identity function and the boundary arithmetic exact.
///
/// `value` is JSON typed by `subjectKind` — a working pattern today. The kind is a closed
/// vocabulary checked at the route boundary, which is what keeps an unvalidated payload from
/// being a hole: an unrecognised subject never reaches here.
///
/// `by` / `byId` / `byEmail` are stamped from the actor, exactly as an audit entry is, and never
/// from the incoming action — there is nothing here for a client to forge.
model Version {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// `ver-12`, minted from the durable workspace counter in `WorkspaceMeta`.
  id String

  subjectKind String
  subjectId   String

  validFrom String
  validTo   String?

  value Json

  recordedAt DateTime
  by         String
  byId       String?
  byEmail    String?
  reason     String  @db.Text

  @@id([tenantId, id])
  /// Ordered as the queries ask: every read is "the periods for this subject", oldest first.
  @@index([tenantId, subjectKind, subjectId, validFrom])
}
