# Axiomate — configuration.
#
# Copy to `.env` and fill in what applies. Everything here is optional: with none of it set the
# application runs from the seed file, in one browser, as one configured operator. Each block
# below turns on a capability and says what it costs to leave off.

# ---------------------------------------------------------------------------
# Database
#
# Without it the workspace lives in the browser's own storage and is lost when that is cleared.
# Postgres 14 or later; `npx prisma migrate deploy` applies the schema.
DATABASE_URL=postgresql://user:password@localhost:5432/axiomate

# How many database connections one instantiation of the client may hold. Default 8.
#
# Count it twice: Next compiles the client module into two separately instantiated copies, one
# for route handlers and one for the rendered page, so a single instance holds up to double
# this. A Burstable B1ms server allows 50 and reserves 15, leaving 35 — so 8 fits two app
# instances with room for a migration, and does not fit three. Raise it with the server, never
# on its own.
AXIOMATE_DB_POOL_MAX=

# How many audit entries the application carries in memory. Default 5000.
#
# Not a display limit: the trail is loaded whole on every page render and inside every write
# transaction, so this is the size of the thing the reducer folds over — around two thirds of a
# megabyte at the default. The database keeps every entry regardless; this decides how much of
# it the application can see, so the record stays complete where it is evidence and bounded
# where it is working memory.
AXIOMATE_AUDIT_WINDOW=

# ---------------------------------------------------------------------------
# Who this deployment serves
#
# The tenant is the delivery firm, not its clients. A slug: lowercase, digits and hyphens.
AXIOMATE_TENANT=axiocloud

# The name written into the audit trail when there is no identity provider. Set it. A second
# deployment that leaves this unset attributes its entire trail to a person who has never
# touched it, which is worse than an unattributed one.
AXIOMATE_OPERATOR=

# ---------------------------------------------------------------------------
# Identity — Microsoft Entra ID
#
# Set all four and sign-in is enforced: an unverified request gets nothing — no page, no
# workspace, no assistant, no writes. Leave any of them empty and the application keeps running
# as the single operator above, because a deployment without credentials should work rather
# than show a login it cannot satisfy.
#
# One thing to do on day one, before anybody else signs in. A person's roles are matched from
# the people directory by the work address Entra returns, and anybody the directory does not
# recognise falls back to the role in the permissions screen — which ships as Administrator so
# that a single-operator deployment is usable. Fill in the addresses in Master data, then empty
# the fallback. Until you do, everyone who signs in is an administrator and nothing says so.
#
# In the Entra portal: App registrations → New registration → Web, with the redirect URI below.
# Then Certificates & secrets → New client secret. The app needs no API permissions beyond the
# default openid, profile and email.
AXIOMATE_ENTRA_TENANT_ID=
AXIOMATE_ENTRA_CLIENT_ID=
AXIOMATE_ENTRA_CLIENT_SECRET=
AXIOMATE_ENTRA_REDIRECT_URI=https://your-host/api/auth/callback

# Signs the session cookie. At least 32 characters, and different in every environment —
# `openssl rand -base64 48` will do. No secret means no sessions, deliberately: a signing key
# with a default is a key everybody has.
AXIOMATE_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Attached files
#
# Where uploaded documents are stored. They go into the firm's own SharePoint document library
# through Microsoft Graph, using the Entra credentials above — so there is no extra resource and
# no extra bill, and the files are reachable in Teams and Office by people who never open this
# application.
#
# Two things have to happen, in this order, and until BOTH are done every upload is refused at
# the door with a sentence saying which one is outstanding:
#
#   1. An administrator grants this registration the APPLICATION permission
#      `Files.ReadWrite.All` (or `Sites.ReadWrite.All` if the library lives on a site), and
#      grants admin consent. Delegated will not work: a document uploaded by a consultant who
#      later leaves would become unreachable when their account is disabled, which is how the
#      acceptance evidence for a delivered milestone gets lost.
#
#   2. Set this to the target library's drive id. To find it:
#      GET https://graph.microsoft.com/v1.0/sites/<host>:/sites/<site>:/drives
#
# Worth knowing: because the token is app-only, SharePoint's own permissions are NOT a second
# line of defence — everything in the configured library is reachable by this application, and
# who may read what is decided by this app's own grants. Point it at a library that exists for
# this purpose rather than at one people already share.
AXIOMATE_DOCS_DRIVE_ID=

# ---------------------------------------------------------------------------
# Intake
#
# The shared secret the intake endpoint requires. Unset means intake refuses everything, which
# is the right default for an endpoint that creates records from outside the firm. Whatever
# forwards mail sends this as `Authorization: Bearer <token>`.
AXIOMATE_INTAKE_TOKEN=

# ---------------------------------------------------------------------------
# The scheduled pass
#
# Nothing in this application wakes itself up: a timer inside the web server stops when the
# process restarts and runs twice when there are two instances. Point whatever already runs
# things on a schedule at POST /api/schedule/run with this as a bearer token — Task Scheduler,
# cron, a GitHub Action, an Azure timer. Daily, first thing, is the usual answer.
#
# Unset means the endpoint accepts only a signed-in operator who may configure the platform,
# which is enough to run it by hand and not enough to run it on a schedule.
AXIOMATE_SCHEDULE_TOKEN=

# ---------------------------------------------------------------------------
# The assistant
#
# Without a key the assistant answers from the workspace index alone and cannot draft changes.
ANTHROPIC_API_KEY=
