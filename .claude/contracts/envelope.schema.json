{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axiomate/contracts/envelope",
  "title": "Artifact envelope",
  "type": "object",
  "required": ["id", "kind", "version", "status", "producer", "created", "title", "traces", "supersedes", "approvals", "body"],
  "properties": {
    "id": { "type": "string", "pattern": "^ART-[0-9]{8}-[0-9]{3}$" },
    "kind": {
      "type": "string",
      "enum": [
        "requirement-specification",
        "architecture-decision",
        "implementation-plan",
        "change-set",
        "validation-result",
        "risk-assessment",
        "release-decision",
        "incident-report"
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "proposed", "approved", "rejected", "final", "superseded"] },
    "producer": {
      "type": "object",
      "required": ["agent", "run"],
      "properties": {
        "agent": { "type": "string" },
        "run": { "type": "string" }
      }
    },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "traces": { "type": "array", "items": { "type": "string", "pattern": "^ART-[0-9]{8}-[0-9]{3}$" } },
    "supersedes": { "type": ["string", "null"], "pattern": "^ART-[0-9]{8}-[0-9]{3}$" },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "by", "date", "evidence"],
        "properties": {
          "role": { "type": "string", "enum": ["product-owner", "architect", "engineering-lead", "security-approver", "release-approver"] },
          "by": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "body": { "type": "object" }
  }
}
