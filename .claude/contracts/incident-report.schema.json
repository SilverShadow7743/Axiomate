{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axiomate/contracts/incident-report",
  "title": "Incident Report body",
  "type": "object",
  "required": ["source", "observed", "expected", "expected_model_ref", "gap", "root_cause", "severity", "correction_ref", "incident_status"],
  "properties": {
    "source": { "type": "string", "enum": ["azure-monitor", "user", "scheduled-pass", "scenario-regression", "integrity-audit", "health-check"] },
    "observed": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "minLength": 1 },
    "expected_model_ref": { "type": "string", "minLength": 1 },
    "gap": { "type": "string", "minLength": 1 },
    "root_cause": { "type": ["string", "null"] },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "correction_ref": { "type": ["string", "null"], "pattern": "^ART-[0-9]{8}-[0-9]{3}$" },
    "incident_status": { "type": "string", "enum": ["open", "diagnosed", "corrected", "closed"] }
  }
}
