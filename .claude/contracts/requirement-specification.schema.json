{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axiomate/contracts/requirement-specification",
  "title": "Requirement Specification body",
  "type": "object",
  "required": ["problem", "source", "request_kind", "priority", "scope_in", "scope_out", "acceptance_criteria", "business_rules", "domain_entities", "open_questions"],
  "properties": {
    "problem": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["reference", "evidence_level"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "evidence_level": { "type": "string", "enum": ["E1", "E2", "E3", "E4", "E5"] }
      }
    },
    "request_kind": { "type": "string", "enum": ["feature", "correction", "debt", "incident-fix"] },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] },
    "scope_in": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "scope_out": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string" }
        }
      }
    },
    "business_rules": { "type": "array", "items": { "type": "string" } },
    "domain_entities": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
