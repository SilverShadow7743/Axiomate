{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axiomate/contracts/implementation-plan",
  "title": "Implementation Plan body",
  "type": "object",
  "required": ["design_ref", "workstreams", "steps", "protected_paths_touched", "migration", "commit_boundaries", "highest_regression_risk_step", "rollback"],
  "properties": {
    "design_ref": { "type": "string", "minLength": 1 },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "owns"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "owns": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "workstream", "verify_command", "risk"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "workstream": { "type": "string" },
          "verify_command": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "done": { "type": "boolean" }
        }
      }
    },
    "protected_paths_touched": { "type": "array", "items": { "type": "string" } },
    "migration": { "type": "boolean" },
    "commit_boundaries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "highest_regression_risk_step": { "type": "integer", "minimum": 1 },
    "rollback": { "type": "string", "minLength": 1 }
  }
}
