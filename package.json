{
  "name": "axiomate-tms",
  "version": "1.0.0",
  "description": "Axiomate TMS — Issue Tree & Resolution Schedule",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "transform": "node scripts/transform-issues.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:check": "node scripts/db-check.mjs",
    "audit:tenancy": "node scripts/tenant-audit.mjs",
    "audit:attribution": "npx tsx scripts/attribution-proof.ts",
    "audit:restore": "npx tsx scripts/restore-proof.ts",
    "audit:estimation": "npx tsx scripts/estimation-proof.ts",
    "audit:a11y": "eslint components app",
    "audit:discussion": "npx tsx --conditions=react-server scripts/discussion-proof.ts",
    "audit:persistence": "npx tsx --conditions=react-server scripts/persistence-proof.ts",
    "audit:rls": "npx tsx --conditions=react-server scripts/rls-proof.ts",
    "validate:scenarios": "npx tsx scripts/scenario-validation.ts",
    "validate:report": "node scripts/build-validation-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.9",
    "next": "^16.2.9",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.16",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
